# client.config -- the CONSUMER side: the FlowCept consumer that drains the broker and
# the MongoDB sink it writes into. (What runs is in workloads/workload.config; the broker
# is in server/server.config.) Override any key with an env var of the same UPPERCASE name.

mongo:
  db: darshan_stream     # MongoDB database the FlowCept consumer drains into
  port: 27017            # mongod port
  cache_gb:              # mongod --wiredTigerCacheSizeGB (blank = default; set on shared nodes)
  dbpath:                # mongod --dbpath (blank = per-run dir on node-local /tmp; set to override)

consumer:                # FlowCept settings, rendered into flowcept_settings.yaml
  consumers: 1           # parallel sharded drainers; each pins a disjoint partition subset and they
                         # all share ONE mongod (FlowCept upserts on the unique task_id, so the
                         # shards dedup safely). Needs server.config partitions >= consumers to scale.
  mq_buffer_size: 1000   # events buffered before insert (raised: consumer node is fully allocated)
  mq_flush_secs: 5       # max wait before flushing the mq buffer
  db_buffer_size: 1000   # DocumentInserter batch size to mongo (bigger batches = higher drain throughput)
  db_flush_secs: 5       # mongo-insert flush interval
