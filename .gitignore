# local builds and installs
/darshan-install/
/darshan-install-*/
/darshan-logs/
/darshan/_build*/
/darshan/install*/
/diaspora-stream-api/_build*/
/diaspora-stream-api/install/

# demo build outputs (compiled workload binaries)
/workloads/c/mofka_forward_smoke
/workloads/c/mofka_forward_mpiio
/workloads/mpi/mofka_forward_mpiio

# PBS job stdout/stderr copied into results/ by submit.sh
/results/*.OU
/results/*.o[0-9]*

# OpenMPI per-rank crash backtraces (host.rank.pid) dropped in the repo root
/i[0-9]*.[0-9]*.[0-9]*
/*.btr

# broker runtime outputs
/server/mofka.json
/server/bedrock.log
/server/bedrock.pid

# machine-specific environment
/server/env.local.sh

# automated setup build outputs (rebuilt by install/setup.sh from install/config.yaml)
/install/_spack/
/install/_venv/
/install/_dlio_venv/
/install/_mofka/
/server/_mongo_env/
/Database/_mongo_env/

# archived old run artifacts + PBS .OU logs moved out of results/ to declutter
/results_archive/
/results_old/

# compiled io_bench binary (source is workloads/c/io_bench.c; binary is a build output)
/workloads/c/io_bench

# per-run temp nodefiles written by the study allocator
/results/_nf_*

# local upstream Mofka reference clone (github.com/mochi-hpc/mofka) for dev only
/_dev/

# per-run result folders (runtime output; job.sh mkdir -p's them)
/results/*/
# ...except the curated per-workload artifact folders (native/streamed .darshan + pydarshan HTML)
!/results/c/
!/results/python-ml/
!/results/mpi/

# env-snapshot: diagnostic dump (contains machine-specific PATH/user paths).
# Regenerate with server/capture-env.sh; do not commit (would leak user paths).
/server/env-snapshot/

# job run outputs and artifacts
/server/_pbs_*/
/server/_diag_*/
/server/_scale_*/
/server/_flowcept_run/
/server/_flowcept_run.*/
*.o[0-9]*
/data/
/hydra_log/

# generated files and crashes
*.o
*.log
*.pyc
core
core.*
core-*
__pycache__/


# overnight driver logs
/overnight_logs/

# machine-specific spack symlink (trailing-slash rule misses the symlink)
/install/_spack
# broker + workload runtime outputs
/server/_broker/
/server/_broker.*/
/server/_wl_hostfile
/server/_wl_hostfile.*
/server/_broker_hostfile
/server/_broker_hostfile.*
/server/_study_wl_hostfile
/server/_sweep_wl_hostfile
# results run-id marker (dotfile not caught by /results/*/ or *.OU)
/results/.g8_base_jobid

# autonomous campaign run log (not for git)
/.campaign/
